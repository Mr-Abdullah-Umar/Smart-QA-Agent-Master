<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Regression Report - {{ regression_id }}</title>
  <style>
    :root { --bg:#f8fafc; --card:#fff; --border:#e2e8f0; --text:#0f172a; --muted:#64748b;
            --ok:#16a34a; --bad:#dc2626; --warn:#d97706; --primary:#2563eb; }
    @media (prefers-color-scheme: dark) {
      :root { --bg:#0f172a; --card:#1e293b; --border:#334155; --text:#f8fafc; --muted:#94a3b8; }
    }
    body { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
           background:var(--bg); color:var(--text); margin:0; padding:24px; line-height:1.5; }
    .container { max-width:1200px; margin:0 auto; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:16px; margin:20px 0; }
    .metric, .card { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:16px; }
    .metric { text-align:center; }
    .value { font-size:28px; font-weight:700; }
    table { width:100%; border-collapse:collapse; font-size:14px; }
    th, td { padding:10px 12px; text-align:left; border-bottom:1px solid var(--border); vertical-align:top; }
    th { color:var(--muted); }
    .badge { display:inline-block; padding:3px 8px; border-radius:4px; font-size:12px; font-weight:600; text-transform:uppercase; }
    .passed { background:#dcfce7; color:#15803d; }
    .failed, .error { background:#fee2e2; color:#b91c1c; }
    code { font-family:ui-monospace,Consolas,monospace; }
  </style>
</head>
<body>
<div class="container">
  <h1>Regression Report</h1>
  <p style="color:var(--muted)">
    ID: <code>{{ regression_id }}</code> | Generated: {{ generated_at }}
    {% if triggered_by %}| Triggered by: <strong>{{ triggered_by }}</strong>{% endif %}
    {% if tag %}| Filter: <strong>{{ tag }}</strong>{% endif %}
    {% if environment %}| Environment: <strong>{{ environment }}</strong>{% endif %}
  </p>

  <div class="grid">
    <div class="metric"><div style="color:var(--muted)">SUITES</div><div class="value">{{ suites|length }}</div></div>
    <div class="metric"><div style="color:var(--muted)">TESTS</div><div class="value">{{ totals.total }}</div></div>
    <div class="metric"><div style="color:var(--ok)">PASSED</div><div class="value" style="color:var(--ok)">{{ totals.passed }}</div></div>
    <div class="metric"><div style="color:var(--bad)">FAILED</div><div class="value" style="color:var(--bad)">{{ totals.failed }}</div></div>
    <div class="metric"><div style="color:var(--warn)">FLAKY</div><div class="value" style="color:var(--warn)">{{ totals.flaky }}</div></div>
    <div class="metric"><div style="color:var(--muted)">BLOCKED</div><div class="value">{{ totals.blocked }}</div></div>
  </div>

  <div class="card">
    <h2>Suites</h2>
    <table>
      <thead><tr><th>Module</th><th>Version</th><th>Status</th><th>Passed / Total</th><th>Failed</th><th>Newly failing</th><th>Fixed</th><th>Report</th></tr></thead>
      <tbody>
      {% for s in suites %}
        <tr>
          <td><strong>{{ s.module }}</strong>{% if s.error %}<br><small style="color:var(--bad)">{{ s.error }}</small>{% endif %}</td>
          <td>v{{ s.version }}</td>
          <td><span class="badge {{ s.status }}">{{ s.status }}</span></td>
          <td>{{ s.passed }} / {{ s.total }}</td>
          <td>{{ s.failed }}</td>
          <td>{% if s.newly_failing %}<code>{{ s.newly_failing|join(', ') }}</code>{% else %}-{% endif %}</td>
          <td>{% if s.fixed %}<code>{{ s.fixed|join(', ') }}</code>{% else %}-{% endif %}</td>
          <td>{% if s.report_html %}<a href="file:///{{ s.report_html|replace('\\', '/') }}">HTML</a>{% else %}-{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
